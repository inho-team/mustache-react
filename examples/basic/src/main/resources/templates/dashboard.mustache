<!doctype html>
<html lang="{{mr.lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#mr.t}}dashboard.title{{/mr.t}}</title>
  {{{mr.head}}}
</head>
<body>
<main class="page">
  <h1>{{#mr.t}}dashboard.title{{/mr.t}}</h1>
  {{! 메시지는 messages.properties / messages_en.properties 에서 }}
  <p>{{#mr.t}}dashboard.intro{{/mr.t}}</p>

  {{! islands/OrderChart.tsx 에 model의 orders, currency 를 props로 전달 }}
  {{#react}}OrderChart orders currency{{/react}}

  <table>
    <thead><tr><th>{{#mr.t}}orders.column.id{{/mr.t}}</th><th>{{#mr.t}}orders.column.customer{{/mr.t}}</th><th>{{#mr.t}}orders.column.status{{/mr.t}}</th></tr></thead>
    <tbody>
    {{#orders}}
      <tr>
        <td>{{id}}</td>
        <td>{{customer}}</td>
        {{! 루프 안에서는 현재 주문의 값을 먼저 찾습니다 }}
        <td>{{#react}}StatusBadge status orderId=id{{/react}}</td>
      </tr>
    {{/orders}}
    </tbody>
  </table>
</main>
{{{mr.scripts}}}
</body>
</html>
