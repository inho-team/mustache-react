<!doctype html>
<html lang="{{mr.lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#mr.t}}dashboard.title{{/mr.t}}</title>
  {{! 엔트리 CSS (mr.head 와 같습니다) }}
  <react:head />
</head>
<body>
<main class="page">
  <h1>{{#mr.t}}dashboard.title{{/mr.t}}</h1>
  {{! 메시지는 messages.properties / messages_en.properties 에서 }}
  <p>{{#mr.t}}dashboard.intro{{/mr.t}}</p>

  {{! islands/OrderChart.tsx. 값이 중괄호 변수 하나뿐이면 객체 그대로(리스트) 전달됩니다 }}
  <react:OrderChart orders="{{orders}}" currency="{{currency}}" />

  <table>
    <thead><tr><th>{{#mr.t}}orders.column.id{{/mr.t}}</th><th>{{#mr.t}}orders.column.customer{{/mr.t}}</th><th>{{#mr.t}}orders.column.status{{/mr.t}}</th></tr></thead>
    <tbody>
    {{#orders}}
      <tr>
        <td>{{id}}</td>
        <td>{{customer}}</td>
        {{! 루프 안에서는 현재 주문의 값을 먼저 찾습니다. order-id 는 prop orderId 가 됩니다 }}
        <td><react:StatusBadge status="{{status}}" order-id="{{id}}" /></td>
      </tr>
    {{/orders}}
    </tbody>
  </table>
</main>
{{! 마지막 island 뒤에: 서버 컨텍스트와 React를 붙이는 스크립트 (mr.scripts 와 같습니다) }}
<react:scripts />
</body>
</html>
