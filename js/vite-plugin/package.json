{
  "name": "@mustache-react/vite-plugin",
  "version": "0.1.0-SNAPSHOT",
  "description": "Vite plugin and mustache-react-vite CLI for mustache-react: generated entries, manifest for Spring, dev server and SSR bundle.",
  "license": "Apache-2.0",
  "homepage": "https://inho-team.github.io/mustache-react/",
  "bugs": {
    "url": "https://github.com/inho-team/mustache-react/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "spring-boot",
    "mustache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inho-team/mustache-react.git",
    "directory": "js/vite-plugin"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5",
    "@vitejs/plugin-react": ">=4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "bin": {
    "mustache-react-vite": "./bin/mustache-react-vite.js"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
