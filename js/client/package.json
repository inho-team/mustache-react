{
  "name": "@mustache-react/client",
  "version": "0.1.0-SNAPSHOT",
  "description": "Browser runtime for mustache-react: mounts and hydrates the React pages and islands Spring renders, with useServerContext and useSpringForm.",
  "license": "Apache-2.0",
  "homepage": "https://inho-team.github.io/mustache-react/",
  "bugs": {
    "url": "https://github.com/inho-team/mustache-react/issues"
  },
  "keywords": [
    "react",
    "spring-boot",
    "spring-mvc",
    "mustache",
    "islands",
    "hydration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inho-team/mustache-react.git",
    "directory": "js/client"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
